{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "church-untold",
	"main": "src/worker.js",
	"compatibility_date": "2026-07-10",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "untold.ducenhan.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "church-untold",
			"database_id": "4ac42d9e-bd2f-406c-86b7-47a7f224824d"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}
